rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가게 계정(pos@shintoebulyi.app)으로 로그인한 기기만 읽고 쓸 수 있습니다.
    // 다른 이메일로 가입한 계정은 모두 거부됩니다.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'pos@shintoebulyi.app';
    }
  }
}
